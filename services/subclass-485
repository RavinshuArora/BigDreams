    .g-navlinks > a:not(.g-button):hover {
      color: var(--bd-gold-dark);
    }

    .g-menu-toggle {
      display: none;
      padding: 9px 12px;
      border: 1px solid var(--bd-border);
      border-radius: 5px;
      background: #fff;
      color: var(--bd-navy);
      font-size: 20px;
      cursor: pointer;
    }

    /* Hero */
    .g-hero {
      position: relative;
      display: flex;
      min-height: 590px;
      align-items: center;
      overflow: hidden;
      background: var(--bd-navy);
      color: #fff;
    }

    .g-hero-video {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: .36;
    }

    .g-hero-overlay {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(90deg, rgba(9,29,52,.97) 0%,
        rgba(16,45,80,.88) 54%, rgba(16,45,80,.44) 100%),
        linear-gradient(0deg, rgba(9,29,52,.5), transparent);
    }

    .g-hero-content {
      position: relative;
      z-index: 2;
      width: 100%;
      padding: 85px 0;
      animation: g-rise .8s ease both;
    }

    .g-breadcrumb {
      margin-bottom: 27px;
      color: rgba(255,255,255,.75);
      font-size: 12px;
    }

    .g-breadcrumb a:hover { color: var(--bd-gold); }

    .g-hero h1 {
      max-width: 780px;
      margin: 0 0 24px;
      color: #fff;
      font-size: clamp(39px, 6vw, 66px);
      line-height: 1.08;
      letter-spacing: -1.8px;
    }

    .g-hero h1 span { color: var(--bd-gold); }

    .g-hero p {
      max-width: 660px;
      margin: 0 0 30px;
      color: rgba(255,255,255,.88);
      font-size: 17px;
    }

    .g-hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 13px;
    }

    .g-hero-note {
      margin-top: 24px;
      color: rgba(255,255,255,.68);
      font-size: 12px;
    }

    /* Highlights */
    .g-highlights {
      position: relative;
      z-index: 3;
      margin-top: -36px;
    }

    .g-highlight-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      border: 1px solid var(--bd-border);
      border-radius: 9px;
      background: #fff;
      box-shadow: 0 15px 45px rgba(16,45,80,.08);
    }

    .g-highlight {
      padding: 27px;
      text-align: center;
    }

    .g-highlight + .g-highlight {
      border-left: 1px solid var(--bd-border);
    }

    .g-highlight strong {
      display: block;
      margin-bottom: 4px;
      color: var(--bd-navy);
      font-size: 17px;
    }

    .g-highlight span {
      color: var(--bd-muted);
      font-size: 12px;
    }

    /* Intro */
    .g-two-col {
      display: grid;
      grid-template-columns: 1.05fr .95fr;
      gap: 60px;
      align-items: center;
    }

    .g-copy h2 {
      margin: 0 0 20px;
      color: var(--bd-navy);
      font-size: clamp(29px, 3.6vw, 42px);
      line-height: 1.2;
    }

    .g-copy p { color: var(--bd-muted); }

    .g-check-list {
      display: grid;
      gap: 13px;
      margin: 25px 0 30px;
      padding: 0;
      list-style: none;
    }

    .g-check-list li {
      display: flex;
      align-items: flex-start;
      gap: 12px;
    }

    .g-check {
      display: inline-flex;
      width: 23px;
      height: 23px;
      flex: 0 0 23px;
      align-items: center;
      justify-content: center;
      margin-top: 2px;
      border-radius: 50%;
      background: #f9edda;
      color: var(--bd-gold-dark);
      font-size: 13px;
      font-weight: 900;
    }

    .g-side-card {
      position: relative;
      padding: 35px;
      overflow: hidden;
      border: 1px solid var(--bd-border);
      border-radius: 9px;
      background: #fff;
      box-shadow: 0 18px 45px rgba(16,45,80,.07);
    }

    .g-side-card::before {
      position: absolute;
      top: 0;
      left: 0;
      width: 5px;
      height: 100%;
      background: var(--bd-gold);
      content: "";
    }

    .g-side-card h3 {
      margin: 0 0 14px;
      color: var(--bd-navy);
      font-size: 24px;
    }

    .g-side-card p {
      color: var(--bd-muted);
      font-size: 14px;
    }

    .g-side-card a {
      color: var(--bd-gold-dark);
      font-weight: 800;
    }

    /* Stream cards */
    .g-card-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 22px;
      margin-top: 44px;
    }

    .g-card {
      position: relative;
      padding: 30px;
      border: 1px solid var(--bd-border);
      border-radius: 8px;
      background: #fff;
      transition: transform .25s ease, box-shadow .25s ease;
    }

    .g-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 18px 38px rgba(16,45,80,.09);
    }

    .g-card-number {
      display: inline-flex;
      width: 44px;
      height: 44px;
      align-items: center;
      justify-content: center;
      margin-bottom: 20px;
      border-radius: 6px;
      background: #f9edda;
      color: var(--bd-gold-dark);
      font-size: 13px;
      font-weight: 900;
    }

    .g-card h3 {
      margin: 0 0 12px;
      color: var(--bd-navy);
      font-size: 21px;
      line-height: 1.3;
    }

    .g-card p {
      margin: 0 0 17px;
      color: var(--bd-muted);
      font-size: 14px;
    }

    .g-card small {
      display: block;
      padding-top: 15px;
      border-top: 1px solid var(--bd-border);
      color: var(--bd-navy);
      font-size: 12px;
      font-weight: 800;
    }

    /* Eligibility */
    .g-eligibility {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 17px;
      margin-top: 38px;
    }

    .g-eligibility-item {
      display: flex;
      gap: 15px;
      padding: 22px;
      border: 1px solid var(--bd-border);
      border-radius: 7px;
      background: #fff;
    }

    .g-eligibility-item h3 {
      margin: 0 0 6px;
      color: var(--bd-navy);
      font-size: 16px;
    }

    .g-eligibility-item p {
      margin: 0;
      color: var(--bd-muted);
      font-size: 13px;
    }

    /* Process */
    .g-process {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      margin-top: 45px;
    }

    .g-process-item {
      padding-top: 22px;
      border-top: 2px solid var(--bd-gold);
    }

    .g-process-item span {
      color: var(--bd-gold-dark);
      font-size: 12px;
      font-weight: 900;
      letter-spacing: 1px;
    }

    .g-process-item h3 {
      margin: 10px 0;
      color: var(--bd-navy);
      font-size: 18px;
    }

    .g-process-item p {
      margin: 0;
      color: var(--bd-muted);
      font-size: 13px;
    }

    /* CTA */
    .g-cta {
      position: relative;
      overflow: hidden;
      padding: 65px 30px;
      border-radius: 10px;
      background: var(--bd-navy);
      text-align: center;
      color: #fff;
    }

    .g-cta::after {
      position: absolute;
      top: -110px;
      right: -80px;
      width: 300px;
      height: 300px;
      border: 1px solid rgba(212,162,83,.35);
      border-radius: 50%;
      content: "";
    }

    .g-cta h2 {
      position: relative;
      z-index: 1;
      max-width: 720px;
      margin: 0 auto 17px;
      color: #fff;
      font-size: clamp(28px, 4vw, 40px);
      line-height: 1.2;
    }

    .g-cta p {
      position: relative;
      z-index: 1;
      max-width: 620px;
      margin: 0 auto 25px;
      color: rgba(255,255,255,.8);
    }

    .g-cta .g-button { position: relative; z-index: 1; }

    /* FAQs */
    .g-faq-list {
      max-width: 850px;
      margin: 40px auto 0;
    }

    .g-faq-list details {
      margin-bottom: 12px;
      padding: 19px 22px;
      border: 1px solid var(--bd-border);
      border-radius: 7px;
      background: #fff;
    }

    .g-faq-list summary {
      position: relative;
      padding-right: 25px;
      color: var(--bd-navy);
      font-size: 15px;
      font-weight: 800;
      cursor: pointer;
      list-style: none;
    }

    .g-faq-list summary::-webkit-details-marker { display: none; }

    .g-faq-list summary::after {
      position: absolute;
      right: 0;
      color: var(--bd-gold-dark);
      content: "+";
      font-size: 20px;
      line-height: 1;
    }

    .g-faq-list details[open] summary::after { content: "−"; }

    .g-faq-list details p {
      margin: 14px 0 0;
      color: var(--bd-muted);
      font-size: 14px;
    }

    .g-disclaimer {
      margin-top: 35px;
      padding: 18px 20px;
      border-left: 3px solid var(--bd-gold);
      background: #fff;
      color: var(--bd-muted);
      font-size: 12px;
    }

    /* Consultation form */
    .g-form-layout {
      display: grid;
      grid-template-columns: .85fr 1.15fr;
      gap: 45px;
      align-items: start;
    }

    .g-form-intro h2 {
      margin: 0 0 17px;
      color: var(--bd-navy);
      font-size: clamp(29px, 4vw, 40px);
      line-height: 1.2;
    }

    .g-form-intro p { color: var(--bd-muted); }

    .g-form {
      padding: 30px;
      border: 1px solid var(--bd-border);
      border-radius: 9px;
      background: #fff;
      box-shadow: 0 15px 40px rgba(16,45,80,.06);
    }

    .g-form-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 17px;
    }

    .g-field {
      display: flex;
      flex-direction: column;
      gap: 7px;
    }

    .g-field-full { grid-column: 1 / -1; }

    .g-field label {
      color: var(--bd-navy);
      font-size: 12px;
      font-weight: 800;
    }

    .g-field input,
    .g-field select,
    .g-field textarea {
      width: 100%;
      min-height: 47px;
      padding: 12px;
      border: 1px solid #dce3eb;
      border-radius: 5px;
      outline: none;
      background: #fff;
      color: var(--bd-text);
      font-size: 14px;
    }

    .g-field textarea {
      min-height: 110px;
      resize: vertical;
    }

    .g-field input:focus,
    .g-field select:focus,
    .g-field textarea:focus {
      border-color: var(--bd-gold);
      box-shadow: 0 0 0 3px rgba(212,162,83,.12);
    }

    .g-form .g-button { width: 100%; margin-top: 20px; }

    .g-form-message {
      margin: 12px 0 0;
      color: var(--bd-muted);
      font-size: 12px;
    }

    /* Footer */
    .g-footer {
      padding: 45px 0 22px;
      background: #0a2039;
      color: rgba(255,255,255,.8);
    }

    .g-footer-inner {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 25px;
      padding-bottom: 30px;
    }

    .g-footer h3 {
      margin: 0 0 12px;
      color: #fff;
      font-size: 17px;
    }

    .g-footer p,
    .g-footer a {
      color: rgba(255,255,255,.7);
      font-size: 12px;
    }

    .g-footer-links {
      display: flex;
      flex-wrap: wrap;
      gap: 18px;
    }

    .g-footer a:hover { color: var(--bd-gold); }

    .g-footer-bottom {
      padding-top: 20px;
      border-top: 1px solid rgba(255,255,255,.13);
      color: rgba(255,255,255,.55);
      font-size: 11px;
    }

    .g-footer-bottom a { color: var(--bd-gold); }

    .g-reveal {
      opacity: 0;
      transform: translateY(18px);
      transition: opacity .65s ease, transform .65s ease;
    }

    .g-reveal.g-visible {
      opacity: 1;
      transform: translateY(0);
    }

    @keyframes g-rise {
      from { opacity: 0; transform: translateY(22px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        scroll-behavior: auto !important;
        animation-duration: .01ms !important;
        transition-duration: .01ms !important;
      }

      .g-reveal { opacity: 1; transform: none; }
    }

    @media (max-width: 960px) {
      .g-navlinks { gap: 12px; }
      .g-navlinks > a:not(.g-button) { display: none; }
      .g-two-col { gap: 30px; }
      .g-card-grid { grid-template-columns: 1fr 1fr; }
      .g-process { grid-template-columns: 1fr 1fr; }
    }

    @media (max-width: 650px) {
      .g-container { width: min(100% - 30px, 1160px); }
      .g-section { padding: 60px 0; }
      .g-nav { min-height: 72px; }
      .g-brand { font-size: 16px; }
      .g-navlinks { gap: 0; }
      .g-navlinks > .g-button { min-height: 42px; padding: 10px 12px; font-size: 11px; }
      .g-hero { min-height: 560px; }
      .g-hero-content { padding: 65px 0; }
      .g-hero h1 { font-size: 41px; }
      .g-hero p { font-size: 15px; }
      .g-highlight-grid { grid-template-columns: 1fr; }
      .g-highlight { padding: 20px; }
      .g-highlight + .g-highlight { border-top: 1px solid var(--bd-border); border-left: 0; }
      .g-two-col, .g-form-layout { grid-template-columns: 1fr; }
      .g-card-grid, .g-eligibility, .g-process { grid-template-columns: 1fr; }
      .g-form { padding: 22px 18px; }
      .g-form-grid { grid-template-columns: 1fr; }
      .g-field-full { grid-column: auto; }
      .g-cta { padding: 48px 22px; }
    }
  </style>
</head>

