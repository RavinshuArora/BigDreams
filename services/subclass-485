  <link rel="stylesheet" href="/styles.css">

  <style>
    :root {
      --bd-navy: #102d50;
      --bd-blue: #1a365d;
      --bd-gold: #d4a253;
      --bd-gold-dark: #b8893e;
      --bd-light: #f5f7fa;
      --bd-text: #26364a;
      --bd-muted: #64748b;
      --bd-white: #ffffff;
      --bd-border: #e3e9f0;
    }

    * { box-sizing: border-box; }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 90px;
    }

    body {
      margin: 0;
      color: var(--bd-text);
      font-family: Arial, Helvetica, sans-serif;
      line-height: 1.7;
      background: #fff;
    }

    body, input, select, textarea, button {
      font-family: Arial, Helvetica, sans-serif;
    }

    .g-page a {
      color: inherit;
      text-decoration: none;
    }

    .g-page img,
    .g-page video {
      max-width: 100%;
    }

    .g-container {
      width: min(1160px, calc(100% - 40px));
      margin: 0 auto;
    }

    .g-section {
      padding: 84px 0;
    }

    .g-section-light {
      background: var(--bd-light);
    }

    .g-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      margin: 0 0 17px;
      color: var(--bd-gold-dark);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    .g-eyebrow::before {
      content: "";
      width: 28px;
      height: 2px;
      background: var(--bd-gold);
    }

    .g-heading {
      max-width: 780px;
      margin: 0 auto 18px;
      color: var(--bd-navy);
      font-size: clamp(29px, 4vw, 43px);
      font-weight: 750;
      line-height: 1.2;
      letter-spacing: -1px;
    }

    .g-description {
      max-width: 720px;
      margin: 0 auto;
      color: var(--bd-muted);
      font-size: 16px;
    }

    .g-center { text-align: center; }

    .g-button {
      display: inline-flex;
      min-height: 49px;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 13px 22px;
      border: 1px solid transparent;
      border-radius: 5px;
      background: var(--bd-gold);
      color: var(--bd-navy) !important;
      font-size: 14px;
      font-weight: 800;
      cursor: pointer;
      transition: transform .25s ease, background .25s ease;
    }

    .g-button:hover {
      background: #e5b96e;
      transform: translateY(-2px);
    }

    .g-button-outline {
      border-color: rgba(255,255,255,.6);
      background: transparent;
      color: #fff !important;
    }

    .g-button-outline:hover {
      background: rgba(255,255,255,.12);
    }

    /* Header */
    .g-header {
      position: relative;
      z-index: 20;
      background: #fff;
      border-bottom: 1px solid var(--bd-border);
    }

    .g-nav {
      min-height: 82px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 25px;
    }

    .g-brand {
      color: var(--bd-navy) !important;
      font-size: 19px;
      font-weight: 900;
      line-height: 1.2;
      letter-spacing: .2px;
    }

    .g-brand span {
      display: block;
      margin-top: 5px;
      color: var(--bd-gold-dark);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 2px;
    }

    .g-navlinks {
      display: flex;
      align-items: center;
      gap: 22px;
      font-size: 12px;
      font-weight: 700;
